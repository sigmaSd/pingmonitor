{
  "tasks": {
    "compile": "deno compile --no-check --output pingChart -A --include src/backend/server.ts --include web src/webview/main.ts",
    "dev": "deno run -A --watch=src/ src/webview/main.ts",
    "dev:android": "deno run -A scripts/dev-android.ts",
    "install": {
      "command": "deno -A jsr:@sigmasd/install-app@0.6.1 install pingChart",
      "dependencies": [
        "compile"
      ]
    }
  },
  "imports": {
    "@sigmasd/gtk": "jsr:@sigmasd/gtk@^0.65.0",
    "@webview/webview": "jsr:@webview/webview@^0.9.0",
    "@sigmasd/denoapk/handler": "jsr:@sigmasd/denoapk/handler"
  },
  "exclude": [
    "distro"
  ],
  "desktop": {
    "app": {
      "name": "Ping Chart",
      "identifier": "io.github.sigmasd.pingmonitor",
      "icons": {
        "linux": "./assets/icon.png"
      }
    }
  }
}
